// A swarm: no turns, reckless gap-closing and long combos, little defense.
// A preset resets the tuning to the defaults, then applies these values (names as in EnhancedCombatBehavior.ini).
{
    "Humanizer": { "BaseReactionDelayMs": 80, "SkillBase": 0.8, "EnableFatigue": false },
    "CombatPacing": { "EnableCombatPacing": false },
    "DecisionMatrix": { "DefendOnSwingChance": 0.2, "CloseDodgeChance": 0.2, "TradeBlowsChance": 0.6, "EvasionJumpChance": 0.7 },
    "DodgeSystem": { "ForwardDodgeChance": 0.5, "ForwardDodgeCooldownSeconds": 4.0 },
    "ModIntegrations": { "ComboFollowUpChance": 0.9, "ComboPowerChance": 0.5 },
    "ScoringWeights": { "AttackBase": 1.3, "SprintAttackBase": 1.6 },
    "DamageMomentum": { "OffensiveBonusMax": 0.8 },
    "TargetSwitching": { "RetaliateChance": 0.8, "FinisherChance": 0.6, "SwitchCooldownSeconds": 3.0 }
}
