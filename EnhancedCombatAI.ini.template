# EnhancedCombatAI Configuration File
# Copy this file to: Data/SKSE/Plugins/EnhancedCombatAI.ini
# Remove the .template extension and edit as needed

[General]
# Enable or disable the plugin
EnablePlugin = true

# Enable debug logging
EnableDebugLog = false

# Processing interval in seconds (how often to process actors)
# Lower values = more responsive but more CPU usage
# Recommended: 0.1 (100ms)
ProcessingInterval = 0.1

[Humanizer]
# One-time reaction delay (ms) before an NPC that just entered combat acts.
# Delay = BaseReactionDelayMs - level * ReactionDelayReductionPerLevelMs (never below
# MinReactionDelayMs), plus up to ReactionVarianceMs of random variance.
BaseReactionDelayMs = 200.0
ReactionVarianceMs = 100.0
ReactionDelayReductionPerLevelMs = 2.0
MinReactionDelayMs = 50.0

# Skill rolls. A deliberate action (dodge, parry, timed block, bash, jump, attack,
# power/sprint attack, feint) rolls once per opportunity: one roll covers a whole
# incoming swing; other openings re-roll every SkillRerollSeconds. A failed roll lets
# that opportunity pass (the NPC eats that hit / misses that opening). Movement never
# rolls; projectile sidesteps use [ProjectileAwareness] DodgeChance instead.
# Skill = SkillBase + SkillPerLevel * (level - 1), clamped to SkillMin..SkillMax,
# then fatigue/panic raise the failure chance (below).
EnableSkillRolls = true
SkillBase = 0.55
SkillPerLevel = 0.008
SkillMin = 0.2
SkillMax = 0.95
SkillRerollSeconds = 1.0

# Cooldowns (seconds) - prevent spam
BashCooldownSeconds = 3.0
SprintAttackCooldownSeconds = 3.0
DodgeCooldownSeconds = 2.0
JumpCooldownSeconds = 3.0

# Fatigue: long fights and low stamina raise the failure chance, up to x(1 + FatigueSkillPenalty)
EnableFatigue = true
# Combat time (seconds) before fatigue starts, and when it is full
FatigueOnsetSeconds = 45.0
FatigueFullSeconds = 180.0
# Below this stamina fraction fatigue rises, reaching full at 0 stamina
FatigueStaminaThreshold = 0.25
FatigueSkillPenalty = 0.5

# Panic: low health raises the failure chance (not retreating), up to x(1 + PanicSkillPenalty)
EnablePanic = true
PanicHealthThreshold = 0.3
PanicSkillPenalty = 0.75

[DodgeSystem]
# Stamina cost for dodging
DodgeStaminaCost = 10.0

# Invulnerability frame duration in seconds
# How long NPCs are invulnerable during dodge
IFrameDuration = 0.3

# Enable step dodge variant
# Uses iStep animation graph variable
EnableStepDodge = false

# Allow dodging during attacks (attack cancel)
EnableDodgeAttackCancel = true
# Forward dodge (TK Dodge) closes the last stretch only: when the target is at most this
# far beyond attack reach (game units) and open - casting, drawing a bow, recovering
# from a swing, staggered, fleeing or facing away. Never at a ready, facing target.
ForwardDodgeMaxGap = 200.0
# Counter: also dodge in when the target is recovering from a swing the NPC evaded
# (dodge/jump) within this many seconds.
ForwardDodgeCounterWindowSeconds = 1.5

# Animation events sent per dodge direction. Defaults are TK Dodge RE's. Another dodge
# framework can be used by naming its events, e.g. The Ultimate Dodge Mod:
#   Forward = ForwardRollStart, Back = BackwardRollStart, Left = Left_RollStart,
#   Right = Right_RollStart, Fallback = RollStart (and DodgeStaminaCost = 0, TUDM charges its own)
DodgeEventForward = TKDodgeForward
DodgeEventBack = TKDodgeBack
DodgeEventLeft = TKDodgeLeft
DodgeEventRight = TKDodgeRight
# Tried when the graph rejects the direction's event. Empty = no second try.
DodgeEventFallback =
# Stamina an NPC needs to start a dodge, without being charged it (the larger of this and
# DodgeStaminaCost is checked). For dodge frameworks that charge their own cost, e.g. TUDM.
MinDodgeStamina = 0.0

[DecisionMatrix]
# Priority 1: Interrupt (Counter-Play)
# Maximum distance for bash interrupt (game units)
# This is used as fallback if Precision mod is not installed
# If Precision is installed, actual weapon reach is used instead
InterruptMaxDistance = 150.0

# Reach multiplier for interrupt decisions
# Multiplies weapon reach when checking if target is in range
# Higher values = more aggressive interrupts
# Recommended: 1.0 to 1.5
InterruptReachMultiplier = 1.2

# Priority 2: Evasion (Tactical)
# Enable evasion dodge when target is blocking or attacking
EnableEvasionDodge = true

# Minimum distance to perform an evasion dodge from an attacking target (game units)
EvasionMinDistance = 250.0

# Enable jump evasion when target is using a bow or crossbow
EnableJumpEvasion = true

# Minimum distance to perform a jump evasion (game units)
JumpEvasionDistanceMin = 500.0

# Maximum distance to perform a jump evasion (game units)
JumpEvasionDistanceMax = 1500.0

# Chance to perform a jump evasion instead of a dodge (0.0 to 1.0)
EvasionJumpChance = 0.5

# Jump apex height in game units (20 to 300). Player jump is roughly 100.
JumpHeight = 100.0

# Priority 3: Survival (Fallback)
# Stamina threshold percentage (0.0 to 1.0)
# NPCs will retreat when stamina falls below this
StaminaThreshold = 0.2

# Health threshold percentage (0.0 to 1.0)
# NPCs will retreat when health falls below this
HealthThreshold = 0.3

# Enable survival retreat
EnableSurvivalRetreat = true

# Priority 4: Offense
# Enable offensive actions (attack, power attack, sprint attack)
EnableOffense = true

# Reach multiplier for offensive decisions
# Higher values = more aggressive attacks
OffenseReachMultiplier = 1.0

# Units subtracted from the reach padding so NPCs commit only when clearly in range
OffenseReachSafetyMargin = 20.0

# Enable NPC sprint (gap-closer) attacks
# If false, NPCs will advance/run toward the target instead of sprint attacking
EnableSprintAttack = true

# Enable sprint charge while advancing (gap-close)
# When advancing, melee NPCs sprint toward the target to close distance (then let
# CPR/vanilla path the charge). If false, advancing only sets CPR advance radii.
EnableSprintCharge = true
# Sprint attacks only launch while the NPC is actually sprinting (CPR sprints it beyond its
# outer advance radius, which is kept at this distance) and the target is within this
# distance (center to center, game units). 0 = 3 x weapon reach. Whether it goes for it
# is the humanizer skill roll.
SprintAttackLaunchDistance = 0.0

# Minimum distance for sprint attack (game units)
SprintAttackMinDistance = 220.0

# Maximum distance for sprint attack (game units)
SprintAttackMaxDistance = 400.0

# Stamina cost for normal attacks
# Not used for decision making - normal attacks always allowed regardless of stamina
# Only kept for reference
AttackStaminaCost = 15.0

# Stamina cost for power attacks
# If EnablePowerAttackStaminaCheck is true, NPCs will only power attack if current stamina >= this value
PowerAttackStaminaCost = 20.0

# Stamina cost for sprint attacks
# Higher than normal attacks due to sprinting + attack consuming more stamina
# If EnableSprintAttackStaminaCheck is true, NPCs will only sprint attack if current stamina >= this value
SprintAttackStaminaCost = 25.0

# Enable stamina check for power attacks
# If true, NPCs will only power attack if current stamina >= PowerAttackStaminaCost
# If false, NPCs can power attack regardless of stamina
# Note: Normal attacks are always allowed regardless of stamina (even if stamina is 0)
EnablePowerAttackStaminaCheck = true

# Enable stamina check for sprint attacks
# If true, NPCs will only sprint attack if current stamina >= SprintAttackStaminaCost
# If false, NPCs can sprint attack regardless of stamina
# Note: Normal attacks are always allowed regardless of stamina (even if stamina is 0)
EnableSprintAttackStaminaCheck = true

[ScoringWeights]
# Curated high-impact tuning weights for the decision matrix.
# Base priorities decide which action tends to win when several are valid.
# Higher = that action is chosen more often. Range 0.0 - 5.0.

# Bash to interrupt a target's power attack
InterruptPowerAttackBase = 1.4

# Dodge/strafe spacing when threatened
EvasionDodgeBase = 1.3

# Run toward the target to close distance
AdvancingBase = 1.0

# Sprint (gap-closer) attack
SprintAttackBase = 1.3

# Normal/power attack while in melee range
AttackBase = 1.0

# Back away from a caster/archer or close aggressor
BackoffBase = 1.8

# Tactical flanking movement with allies
FlankingBase = 1.4

# Offense modifiers - added to attack priority based on the situation. Range 0.0 - 3.0.
# Target knocked down / staggered (perfect opening)
TargetStaggeredBonus = 0.6

# Target casting a spell or drawing a bow
TargetCastingBonus = 0.5

# Target in its attack recovery window
TargetRecoveryBonus = 0.5

# Target fleeing (pursue / finish)
TargetFleeingBonus = 0.4

# Target at very low health (finisher)
TargetLowHealthFinisherBonus = 0.4

# Penalty when the target is ready and facing us (attacking is risky)
OpeningRiskPenalty = 0.4

# Bonus when attacking from behind/side (flanking)
FlankingAttackBonus = 0.3

# Bonus when allies are nearby to cover the attack opening
AllyCoverBonus = 0.2

[Performance]
# Cleanup interval in seconds
# How often to clean up invalid actor references
CleanupInterval = 5.0

# Maximum actors to process per frame
# 0 = unlimited (process all)
# Recommended: 0 (let processing interval handle throttling)
MaxActorsPerFrame = 0

# Adaptive Processing Interval (LOD)
# System adjusts update rate based on distance to player
# Improves performance by updating distant enemies less frequently

# Distance threshold for "Near" range (game units)
# Actors closer than this use ProcessingInterval (fastest)
# Default: 1000.0 (approx 14 meters)
DistanceNear = 1000.0

# Distance threshold for "Mid" range (game units)
# Actors between Near and Mid use ProcessingIntervalMid
# Actors farther than this use ProcessingIntervalFar
# Default: 3000.0 (approx 42 meters)
DistanceMid = 3000.0

# Processing interval for Mid range in seconds
# Default: 0.2 (200ms)
ProcessingIntervalMid = 0.2

# Processing interval for Far range in seconds
# Default: 0.5 (500ms)
ProcessingIntervalFar = 0.5

[ModIntegrations]
# Note: Mod integrations are auto-detected at runtime
# These settings allow you to disable specific integrations if needed

# Enable Combat Pathing Revolution (CPR) integration
# If false, CPR features will not be used even if CPR is installed
# CPR provides enhanced movement control (circling, fallback, advance)
EnableCPRIntegration = true


# Enable Precision mod integration
# If false, will use fallback weapon reach calculations
# Precision provides accurate weapon reach measurements
EnablePrecisionIntegration = true

# Enable TK Dodge RE integration
# If false, NPCs will not use TK Dodge for evasion
# TK Dodge provides dodge/evasion animations
EnableTKDodgeIntegration = true

# SCAR (Skyrim Combos AI Revolution). Auto-detected via SCAR.dll.
# Movesets patched for SCAR raise SCAR_ComboStart; on those NPCs SCAR picks normal/power
# attacks and this mod handles defense, movement and sprint attacks. Unpatched movesets
# keep this mod's offense.
EnableSCARIntegration = true
# A SCAR_ComboStart within this many seconds marks the NPC's moveset as SCAR-driven
SCARComboWindowSeconds = 20.0
# Badly patched movesets: if a SCAR NPC wants to attack this long without attacking,
# this mod attacks for it
SCARStallSeconds = 3.0

[Parry]
# Enable parry mechanism (timed bash for parrying incoming attacks)
# Requires EldenParry mod to be installed
# NPCs will attempt to parry attacks by timing bashes correctly
EnableParry = false

# Parry window start time in seconds
# Bash should start at least this many seconds before attack hits
# Lower values = later parry timing (closer to when attack hits)
# Recommended: 0.05 to 0.15
ParryWindowStart = 0.05

# Parry window end time in seconds
# Latest time to start bash before attack hits
# Higher values = earlier parry timing (further from when attack hits)
# Recommended: 0.2 to 0.3
ParryWindowEnd = 0.25

# Minimum distance for parry (game units)
# NPCs won't attempt parry if target is closer than this
ParryMinDistance = 50.0

# Maximum distance for parry (game units)
# NPCs won't attempt parry if target is farther than this
ParryMaxDistance = 200.0

# Base priority for parry opportunity
# Higher values = NPCs more likely to attempt parry when timing is right
# Recommended: 1.5 to 2.0
ParryBasePriority = 1.5

# Maximum bonus for perfect timing (0.0 to 1.0)
# Perfect timing gets this bonus added to priority
# Higher values = more reward for perfect timing
TimingBonusMax = 0.3

# Penalty for bash too early (0.0 to 1.0)
# Reduces priority if bash happens too early in the window
EarlyBashPenalty = 0.5

# Penalty for bash too late (0.0 to 1.0)
# Reduces priority if bash happens too late in the window
LateBashPenalty = 0.5

[TimedBlock]
# Enable timed block mechanism (timed block for blocking incoming attacks)
# Requires Simple Timed Block mod (SimpleTimedBlock.esp) to be installed
# NPCs will attempt to timed block attacks by timing blocks correctly
EnableTimedBlock = false

# Timed block window start time in seconds
# Block should start at least this many seconds before attack hits
# Lower values = later timed block timing (closer to when attack hits)
# Recommended: 0.05 to 0.15
TimedBlockWindowStart = 0.05

# Timed block window end time in seconds
# Latest time to start block before attack hits
# This should match the mod's window (0.33 seconds)
# Higher values = earlier timed block timing (further from when attack hits)
# Recommended: 0.33 (matches Simple Timed Block mod's window)
TimedBlockWindowEnd = 0.33

# Minimum distance for timed block (game units)
# NPCs won't attempt timed block if target is closer than this
TimedBlockMinDistance = 50.0

# Maximum distance for timed block (game units)
# NPCs won't attempt timed block if target is farther than this
TimedBlockMaxDistance = 200.0

# Base priority for timed block opportunity
# Higher values = NPCs more likely to attempt timed block when timing is right
# Recommended: 1.5 to 2.0
TimedBlockBasePriority = 1.5

# Maximum bonus for perfect timing (0.0 to 1.0)
# Perfect timing gets this bonus added to priority
# Higher values = more reward for perfect timing
TimedBlockTimingBonusMax = 0.3

# Penalty for block too early (0.0 to 1.0)
# Reduces priority if block happens too early in the window
TimedBlockEarlyPenalty = 0.5

# Penalty for block too late (0.0 to 1.0)
# Reduces priority if block happens too late in the window
TimedBlockLatePenalty = 0.5

[CombatPacing]
# "Wait Your Turn" - cap how many attackers hit a target at once; the rest circle
# and wait their turn (rotated in as slots free). Reduces the vanilla group swarm.

# Enable combat pacing
EnableCombatPacing = true

# Maximum attackers allowed to attack the same target simultaneously
# 1 = strict one-at-a-time duel feel; 2-3 = group but not a swarm
MaxSimultaneousAttackers = 2

# How long (seconds) an attacker holds its slot before it rotates out so others get
# a turn. A random value between min and max is chosen each time a slot is taken.
SlotWindowMinSeconds = 2.0
SlotWindowMaxSeconds = 4.0

# Only pace attacks against the player (recommended). If false, pacing also applies
# to NPC-vs-NPC fights.
PaceTargetPlayerOnly = true

# An NPC needs a slot once it is engaging: attacking (its own AI, SCAR or this mod) or
# within its attack reach + EngageMargin of the target. NPCs without a slot wait their
# turn: they circle at reach + WaitDistanceMargin (or back off if already inside reach),
# their vanilla attacks are vetoed, and a swing already in progress is never cancelled.
# SCAR movesets choose their own attacks; keeping waiters outside their lunge range is
# what stops them, so raise WaitDistanceMargin if SCAR NPCs still lunge from the ring.
EngageMargin = 150.0
WaitDistanceMargin = 120.0

# A waiting NPC that gets hit by its target may fight back for a random time in this
# range (no free hits on enemies waiting their turn)
RetaliateMinSeconds = 1.0
RetaliateMaxSeconds = 3.0

[DamageMomentum]
# NPC aggression scales with how hard its recent hits land. Big hits (large chunk of
# the target's health) -> press the advantage (offensive). Chip damage -> cautious and
# tactical (space, wait for openings). Measured from target health lost per hit.

# Enable damage momentum
EnableDamageMomentum = true

# Fraction of the target's MAX health removed per hit for FULL aggression (e.g. 0.08 = 8%)
BigHitThreshold = 0.08

# Fraction at/below which the NPC turns fully defensive
ChipThreshold = 0.03

# Max attack-priority bonus added at full aggression
OffensiveBonusMax = 0.4

# Max attack-priority penalty at full chip. Kept small so a chipping NPC still attacks
# periodically instead of turtling (matters vs tanky/high-armor players).
DefensivePenaltyMax = 0.3

# How long (seconds) momentum takes to fade to 0 with no hits
MomentumDecaySeconds = 5.0

# Smoothing of the per-hit damage fraction (0.0-1.0; higher = reacts faster)
EwmaAlpha = 0.5

[TargetSwitching]
# NPCs turn on whoever just hit them, or switch to a nearly dead enemy nearby.
# Each actor rolls at most once per SwitchCooldownSeconds.
EnableTargetSwitching = true
SwitchCooldownSeconds = 5.0
# A hit can provoke a switch for this long after it lands
RetaliateWindowSeconds = 2.0
RetaliateChance = 0.5
# Ignore attackers farther than this (game units), e.g. archers across the room
RetaliateMaxDistance = 600.0
# An enemy at or below this health fraction counts as "nearly dead"
FinisherHealthThreshold = 0.25
FinisherMaxDistance = 500.0
FinisherChance = 0.35

[ArmorStyle]
# Body armor weight shapes behavior. Light: more dodge/strafe/jump/flank.
# Heavy: fewer dodges, more bash and timed block. Clothing/none: unchanged.
EnableArmorStyle = true
LightEvasionBonus = 0.15
HeavyEvasionPenalty = 0.2
HeavyGuardBonus = 0.15

[Teamwork]
# Followers treat the player as their flanking partner and circle around
# whatever the player is fighting.
EnableFollowerPincer = true
# Extra flanking priority when the target is engaged with the player
FollowerPincerBonus = 0.3

[VanillaAttacks]
# Shapes the attacks the vanilla melee AI picks. The engine still chooses and plays the
# moveset's own attack data; these multiply each candidate attack's chance (0 = never).
# Not used on SkyrimVR. NPCs on SCAR-patched movesets keep SCAR's attack choice.
EnableVanillaAttackShaping = true
# No vanilla attack this long after this mod makes the NPC dodge, block, parry or retreat
DefenseVetoSeconds = 0.6
# Target staggered, recovering from an attack, or casting
OpeningPowerMult = 2.0
OpeningNormalMult = 1.5
# Target blocking and facing the attacker: power attacks break guard, normal ones bounce
BlockedPowerMult = 1.5
BlockedNormalMult = 0.25

[ProjectileAwareness]
# NPCs sidestep (TK Dodge) projectiles on course to hit them: arrows, bolts, spell
# projectiles, flame streams. Read from the engine's own combat threat list. The usual
# dodge cooldown and stamina cost still apply; DodgeChance replaces the skill roll.
EnableProjectileDodge = true
# React only when impact is this many seconds away (closer = too late, farther = not yet).
# An arrow at 3000 u/s crosses 600-2700 units in this window.
ReactMinSeconds = 0.2
ReactMaxSeconds = 0.9
# Chance to react to a given projectile (rolled once per projectile)
DodgeChance = 0.6
# Extra radius (game units) counted as "on course to hit"
HitMargin = 40.0
# Decision priority; melee evasion is ~1.5-2.2
DodgePriority = 2.2

[EnvSensor]
# Don't swing at a target behind a wall/railing (line-of-sight ray at torso height)
EnableLosGate = true
LosEyeHeight = 96.0
# Never dodge or strafe off a ledge: probe for ground where the move would land, and treat
# a drop deeper than DodgeMaxDrop as a cliff
EnableCliffSafeDodge = true
DodgeLedgeProbeDistance = 180.0
DodgeMaxDrop = 200.0
